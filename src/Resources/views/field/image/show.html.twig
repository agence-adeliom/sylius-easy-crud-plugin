<table class="ui very basic celled table">
    <tbody>
    <tr>
        <td class="five wide"><strong class="gray text">{{ (field.label ?? field.property) | trans }}</strong></td>
        <td>
            {% if data|default(null) is not null %}
                <img class="ui small bordered image" src="{{ data|imagine_filter('sylius_small') }}" alt="{{ data }}" />
            {% endif %}
        </td>
    </tr>
    </tbody>
</table>
