{% if resources.definition.driverConfiguration.css_assets is defined %}
    {% for path in resources.definition.driverConfiguration.css_assets %}
        <link rel="stylesheet" href="{{ path }}">
    {% endfor %}
{% endif %}
{% if resources.definition.driverConfiguration.webpack_encore_assets is defined %}
    {% for entry in resources.definition.driverConfiguration.webpack_encore_assets %}
        encore_entry_link_tags(entry)
    {% endfor %}
{% endif %}
