{% import '@SyliusAdmin/Macro/breadcrumb.html.twig' as breadcrumb %}

{# MODIFIE ICI POUR QUE L'ON RETOURNE SUR LA LISTE DES MENUS #}
{% set index_url = path(
    configuration.vars.index.route.name|default(configuration.getRouteName('index')|replace({'_item' : ''}))
)
%}

{% set breadcrumb = configuration.vars.breadcrumb|default(metadata.applicationName ~ '.ui.' ~ metadata.pluralName) %}

{% set breadcrumbs = [
    {label: 'sylius.ui.administration'|trans, url: path('sylius_admin_dashboard')},
    {label: breadcrumb|trans, url: index_url},
]
%}

{% if resource.parent %}
    {% set breadcrumbs = breadcrumbs|merge([
        { label: '...' },
        { label: resource.parent.name|default(resource.parent.code|default(resource.parent.id)), url: path('easy_admin_menu_item_update', {id: resource.parent.id})},
    ]) %}
{% endif %}

{% set breadcrumbs = breadcrumbs|merge([
    { label: resource.name|default(resource.code|default(resource.id)) },
    { label: 'sylius.ui.edit'|trans }
])
%}

{{ breadcrumb.crumble(breadcrumbs) }}
