<div class="ui stackable two column grid">
    <div class="column">
        {% include configuration.vars.templates.header_title|default('@SyliusEasyCrudPlugin/crud/show/_headerTitle.html.twig') %}
        {% include configuration.vars.templates.breadcrumb|default('@SyliusEasyCrudPlugin/crud/show/_breadcrumb.html.twig') %}

        {{ sylius_template_event([event_prefix ~ '.header', 'sylius.admin.update.header'], {'metadata': metadata, 'resource': resource}) }}
    </div>
    <div class="middle aligned column">
        {% include configuration.vars.templates.toolbar|default('@SyliusEasyCrudPlugin/Crud/_toolbar.html.twig') ignore missing %}
    </div>
    {% include '@SyliusEasyCrudPlugin/crud/action/_actions.html.twig' with {marginTop: '1rem'} %}
</div>
