{
    "name": "agence-adeliom/sylius-easy-crud-plugin",
    "type": "symfony-bundle",
    "description": "A plugin for Sylius to simplify custom crud creatio,",
    "keywords": [
        "symfony",
        "sylius",
        "crud builder",
        "easy admin"
    ],
    "homepage": "https://github.com/agence-adeliom/sylius-easy-crud-plugin",
    "license": "MIT",
    "authors": [
      {
        "name": "Community contributions",
        "homepage": "https://github.com/agence-adeliom/sylius-tailwindcss-theme/graphs/contributors"
      }
    ],
    "require": {
        "php": "~8.1|~8.2",
        "symfony/webpack-encore-bundle": "^1.12",
        "ext-json": "*",
        "ext-intl": "*",
        "sylius/sylius": ">=v1.13.0",
        "embed/embed": "^4.4",
        "symfony/uid": "^v6.4.7"
    },
    "conflict": {
      "symfony/framework-bundle": "6.2.8"
    },
    "require-dev": {
      "friendsoftwig/twigcs": "^6.4",
      "lchrusciel/api-test-case": "^5.0",
      "phpmd/phpmd": "^2.15",
      "phpspec/phpspec": "^7.0",
      "phpstan/extension-installer": "^1.0",
      "phpstan/phpstan": "^1.8.4",
      "phpstan/phpstan-doctrine": "^1.3.2",
      "phpstan/phpstan-webmozart-assert": "^1.1",
      "phpunit/phpunit": "^10.5",
      "symplify/easy-coding-standard": "^10.2.11",
      "sylius-labs/coding-standard": "^4.0",
      "symfony/browser-kit": "^5.4",
      "symfony/debug-bundle": "^5.4",
      "symfony/dotenv": "^5.4",
      "symfony/intl": "^5.4",
      "symfony/maker-bundle": "^1.60",
      "symfony/web-profiler-bundle": "^6.4",
      "vimeo/psalm": "5.23.1"
    },
    "autoload": {
      "psr-4": {
        "Adeliom\\SyliusEasyCrudPlugin\\": "src/"
      }
    },
    "autoload-dev": {
      "psr-4": {
        "Adeliom\\SyliusEasyCrudPlugin\\Tests\\": "tests/PHPUnit/"
      }
    },
    "extra": {
      "branch-alias": {
        "dev-master": "0.x-dev"
      }
    },
    "scripts": {
        "auto-scripts": {
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    }
}
