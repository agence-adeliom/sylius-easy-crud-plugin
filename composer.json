{
    "name": "agence-adeliom/sylius-easy-crud-plugin",
    "type": "symfony-bundle",
    "description": "A plugin for Sylius to simplify custom crud creatio,",
    "keywords": [
        "symfony",
        "sylius",
        "crud builder",
        "easy admin"
    ],
    "homepage": "https://github.com/agence-adeliom/sylius-easy-crud-plugin",
    "license": "MIT",
    "authors": [
      {
        "name": "Community contributions",
        "homepage": "https://github.com/agence-adeliom/sylius-easy-crud-plugin/graphs/contributors"
      }
    ],
    "require": {
        "php": "~8.1|~8.2|~8.3|~8.4",
        "symfony/webpack-encore-bundle": "^1.12 || ^2.0",
        "ext-json": "*",
        "ext-intl": "*",
        "sylius/sylius": "^v1.13.0 || ^v2.0",
        "embed/embed": "^4.4",
        "symfony/uid": "^6.4 || ^v7.0"
    },
    "conflict": {
      "symfony/framework-bundle": "6.2.8"
    },
    "require-dev": {
      "friendsoftwig/twigcs": "^6.4 || ^v7.0",
      "lchrusciel/api-test-case": "^5.0",
      "phpmd/phpmd": "^2.15",
      "phpspec/phpspec": "^7.0",
      "phpstan/extension-installer": "^1.0",
      "phpstan/phpstan": "^1.8.4",
      "phpstan/phpstan-doctrine": "^1.3.2",
      "phpstan/phpstan-webmozart-assert": "^1.1",
      "phpunit/phpunit": "^9.6",
      "symplify/easy-coding-standard": "^12.0",
      "symfony/browser-kit": "^6.4 || ^v7.0",
      "symfony/debug-bundle": "^6.4 || ^v7.0",
      "symfony/dotenv": "^6.4 || ^v7.0",
      "symfony/intl": "^6.4 || ^v7.0",
      "symfony/yaml": "^6.4 || ^v7.0",
      "symfony/maker-bundle": "^1.60",
      "symfony/web-profiler-bundle": "^6.4 || ^v7.0",
      "vimeo/psalm": "5.23.1"
    },
    "autoload": {
      "psr-4": {
        "Adeliom\\SyliusEasyCrudPlugin\\": "src/"
      }
    },
    "autoload-dev": {
      "psr-4": {
        "Adeliom\\SyliusEasyCrudPlugin\\Tests\\": "tests/PHPUnit/"
      }
    },
    "extra": {
      "branch-alias": {
        "dev-master": "2.x-dev"
      }
    },
    "scripts": {
        "auto-scripts": {
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true,
            "symfony/runtime": true
        }
    }
}
