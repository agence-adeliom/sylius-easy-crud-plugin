{% set form = hookable_metadata.context.form %}
{% set configuration = hookable_metadata.context.configuration %}

{% if hookable_metadata.renderedBy.name == 'easy_crud.common.show.content.header.title_block' %}
    <div class="col-12 col-md-auto ms-auto d-print-none">
{% endif %}

{% if form.vars.actionsGroups is defined %}
    {% set actions_groups = form.vars.actionsGroups %}
    {% if actions_groups['main'] is defined %}
        {% for action in actions_groups['main'] %}
            {{ crud_render_action(action, configuration) }}
        {% endfor %}
    {% endif %}
    {% if actions_groups['item'] is defined %}
        {% for action in actions_groups['item'] %}
            {{ crud_render_action(action, configuration) }}
        {% endfor %}
    {% endif %}
    {% if actions_groups['subitem'] is defined %}
        {% for action in actions_groups['subitem'] %}
            {{ crud_render_action(action, configuration) }}
        {% endfor %}
    {% endif %}
{% endif %}

{% if hookable_metadata.renderedBy.name == 'easy_crud.common.show.content.header.title_block' %}
    </div>
{% endif %}
