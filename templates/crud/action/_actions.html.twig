{% set form = hookable_metadata.context.form %}
{% set configuration = hookable_metadata.context.configuration %}

{% if hookable_metadata.renderedBy.name == 'easy_crud.common.show.content.header.title_block' %}
    <div class="col-12 col-md-auto ms-auto d-print-none">
{% endif %}

{% if form.vars.actionsGroups is defined %}
    {% set actions_groups = form.vars.actionsGroups %}
    {% if actions_groups['main'] is defined %}
        {% for action in actions_groups['main'] %}
            {{ crud_render_action(action, configuration) }}
        {% endfor %}
    {% endif %}
    {% if actions_groups['item'] is defined %}
        {% for action in actions_groups['item'] %}
            {{ crud_render_action(action, configuration) }}
        {% endfor %}
    {% endif %}
    {% if actions_groups['subitem'] is defined %}
        {% for action in actions_groups['subitem'] %}
            <div class="dropdown">
                <button class="btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    {% if action.icon|default(action.options.icon|default('')) is not empty %}{{ ux_icon(action.icon|default(action.options.icon|default(''))) }}{% endif %}
                    {{ action.label|trans }}
                </button>
                <ul class="dropdown-menu" {{ sylius_test_html_attribute(action.name) }}>
                    {% hook 'subitems' %}
                    {% for link in action.options.links %}
                        {% set id = options.link.parameters['id']|default(hookable_metadata.context.resource.id|default(null))  %}
                        {% set path = link.url is defined ? link.url : path(link.route, (link.parameters|default({})|merge((id?{'id': id}:{})))) %}
                        <li>
                            <a class="dropdown-item" href="{{ path }}" {{ sylius_test_html_attribute('create') }}
                            {% for attr, value in link.htmlAttributes %}{{ attr }}="{{ value }}"{% endfor %}>
                                {{ ux_icon(link.icon, {'class': 'icon dropdown-item-icon'}) }}
                                {{ link.label|trans }}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        {% endfor %}
    {% endif %}
{% endif %}

{% if hookable_metadata.renderedBy.name == 'easy_crud.common.show.content.header.title_block' %}
    </div>
{% endif %}
