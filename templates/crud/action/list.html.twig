{% set visible = options.visible is defined ? options.visible : true %}

{% if visible %}
    <div class="dropdown">
        <button class="btn dropdown-toggle" type="button" data-bs-toggle="dropdown">
            {% if action.label %}
                {{ action.label|trans }}
            {% endif %}
        </button>
        <ul class="dropdown-menu">
            {% for link in options.links %}
                {% set is_link_visible = link.visible is defined ? link.visible : true %}

                {% if is_link_visible %}
                    {% set id = data.id|default(null) %}
                    {% set path = link.url is defined ? link.url : path(link.route, link.parameters|merge({id: id})|default([])) %}
                    <li><a class="dropdown-item" href="{{ path }}">
                            {% if link.icon is defined %}
                                {{ ux_icon(link.icon, {'class': 'icon dropdown-item-icon' }) }}
                            {% endif %}
                            {{ link.label|trans }}
                        </a></li>
                {% endif %}
            {% endfor %}
        </ul>
    </div>
{% endif %}
