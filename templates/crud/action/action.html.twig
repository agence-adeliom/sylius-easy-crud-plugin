{% macro default(url, message, id, icon, class) %}
    <a class="btn {% if class is not empty %} {{ class }} {% endif %}" href="{{ url }}" {% if id is not null %} id="{{ id }}"{% endif %}>
        {% if icon is not empty %}
            {{ ux_icon(icon) }}
        {% endif %}
        {% if message is not empty %}
            {{ message|trans }}
        {% endif %}
    </a>
{% endmacro %}

{% set route_params = options.link.parameters|default({}) %}
{% set route = options.link.route|default(false) %}
{% set url = options.link.url|default(false) %}

{% if data is defined and data.id is defined and url %}
    {% set url = options.link.url|replace({'{id}': data.id}) %}
{% endif %}

{% if url or route %}
    {% set path = url|default(route ? path(route, route_params|merge({'id': route_params.id|default(data.id ?? null)})) : '') %}
    {{ _self.default(path, action.label, null, action.icon, action.options.class|default(null)) }}
{% endif %}
