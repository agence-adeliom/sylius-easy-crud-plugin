{% macro start_column(size, newLine, label) %}
{#    <div class="row">#}
{% endmacro %}

{% macro end_column() %}
{#    </div>#}
{% endmacro %}

{% macro start_tab(firstMenuItem, menuItem) %}
<div class="card mb-3">
    <div class="card-header">
        <div class="card-title">{{ menuItem.label|trans }}</div>
    </div>
    {% endmacro %}

    {% macro end_tab(firstMen) %}
</div>
{% endmacro %}

{% macro form(firstMenuItem, menuItem, form, fields, view='update') %}

    <div class="row">

            {% set column_started = null %}

            {% for column in form.vars.columns %}

                {% for child in form.children %}

                    {% set field_column_id = child.vars.errors.form.config.attributes.columnId ?? null %}
                    {% set column_menu_item = column.menuItem ?? null %}

                    {% if not child.isRendered and (field_column_id == column.id or field_column_id is null) and (menuItem is null or menuItem.name == column_menu_item) %}

                        {% set field_menu_item = child.vars.errors.form.config.attributes.menuItem.name ?? null %}

                        {% set cond_1 = (firstMenuItem is not null and firstMenuItem and menuItem is not null and (field_menu_item is null or field_menu_item == menuItem.name)) %}
                        {% set cond_2 = (firstMenuItem is not null and not firstMenuItem and menuItem is not null and field_menu_item == menuItem.name) %}
                        {% set cond_3 = (firstMenuItem is null and menuItem is null) %}

                        {% if cond_1 or cond_2 or cond_3 %}

                            {% if not column_started %}
                                {{ _self.start_column(column.size, false, column.label) }}
                                {% set column_started = column.id %}
                            {% elseif column_started != column.id %}
                                {{ _self.end_column() }}
                                {{ _self.start_column(column.size, column.newLine, column.label) }}
                                {% set column_started = column.id %}
                            {% endif %}

                            {{ form_row(child) }}

                        {% endif %}
                    {% endif %}
                {% endfor %}

            {% endfor %}

            {% if column_started %}
                {{ _self.end_column() }}
            {% endif %}

    </div>

{% endmacro %}
