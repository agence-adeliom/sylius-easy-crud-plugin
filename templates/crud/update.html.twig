{% extends '@SyliusAdmin/shared/crud/update.html.twig' %}

{% block body %}
    {% form_theme form with form.vars.form_themes %}
    {{ parent() }}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {# we have to override the block because we need access to the "form" variable from the _context, but the sylius event only gives the metadata #}
    {% include "@SyliusEasyCrudPlugin/crud/assets/grid/css.html.twig" %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {# we have to override the block because we need access to the "form" variable from the _context, but the sylius event only gives the metadata #}
    {% include "@SyliusEasyCrudPlugin/crud/assets/grid/js.html.twig" %}
{% endblock %}
