{% extends '@SyliusAdmin/shared/crud/update.html.twig' %}

{% block body %}
    {% set prefixes = [
        'easy_crud.%resource_name%'|replace({'%resource_name%': resource_name|default(metadata.name)}),
        'easy_crud.common',
    ]|merge(prefixes) %}
    {{ parent() }}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {% hook 'update#stylesheets' with { _prefixes: prefixes } %}
    {% include "@SyliusEasyCrudPlugin/crud/assets/css.html.twig" %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% hook 'update#javascripts' with { _prefixes: prefixes } %}
    {% include "@SyliusEasyCrudPlugin/crud/assets/js.html.twig" %}
{% endblock %}
