{% extends '@SyliusAdmin/shared/crud/create.html.twig' %}

{% block body %}
    {% set prefixes = [
        'easy_crud.%resource_name%'|replace({'%resource_name%': resource_name|default(metadata.name)}),
        'easy_crud.common',
    ]|merge(prefixes) %}
    {% hook 'create' with { _prefixes: prefixes, resource, metadata, configuration, form } %}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {% hook 'create#stylesheets' with { _prefixes: prefixes } %}
    {# we have to override the block because we need access to the "form" variable from the _context, but the sylius event only gives the metadata #}
    {% include "@SyliusEasyCrudPlugin/crud/assets/css.html.twig" %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% hook 'create#javascripts' with { _prefixes: prefixes } %}
    {# we have to override the block because we need access to the "form" variable from the _context, but the sylius event only gives the metadata #}
    {% include "@SyliusEasyCrudPlugin/crud/assets/js.html.twig" %}
{% endblock %}
