{% extends '@SyliusAdmin/shared/crud/show.html.twig' %}

{% block body %}
    {% set prefixes = [
        'easy_crud.%resource_name%'|replace({'%resource_name%': resource_name|default(metadata.name)}),
        'easy_crud.common',
    ]|merge(prefixes) %}
    {{ parent() }}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {% include "@SyliusEasyCrudPlugin/crud/assets/show/css.html.twig" %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% include "@SyliusEasyCrudPlugin/crud/assets/show/js.html.twig" %}
{% endblock %}
