{% macro start_column(size, newLine, label) %}
    {% if newLine %}
    </div>
    </div>
    <div class="ui attached segment">
        <div class="ui column stackable grid">
    {% endif %}
            <div class="{{ size.value ?? 'one' }} wide column">
                {% if label %}
                    <h4 class="ui dividing header">{{ label|trans }}</h4>
                {% endif %}
{% endmacro %}

{% macro end_column() %}
    </div>
{% endmacro %}

{% macro start_tab(firstMenuItem, menuItem) %}
    <div class="card mb-3">
        <div class="card-header">
            <div class="card-title">{{ menuItem.label|trans }}</div>
        </div>
{% endmacro %}

{% macro end_tab(firstMen) %}
    </div>
{% endmacro %}

{% macro show(firstMenuItem, menuItem, fields, columns, resource) %}

    {{ dump() }}

    <div class="ui attached segment">
        <div class="ui column stackable grid">

            {% set column_started = null %}

            {% for column in columns %}

                {% for field in fields %}

                    {% set field_column_id = field.getCustomOption('columnId') %}
                    {% set column_menu_item = column.menuItem ?? null %}

                    {% if (field_column_id == column.id or field_column_id is null) and (menuItem is null or menuItem.name == column_menu_item) %}

                        {% set field_menu_item = field.getCustomOption('menuItem').name ?? null %}
                        {% set first_condition = (firstMenuItem is not null and firstMenuItem and menuItem is not null and (field_menu_item is null or field_menu_item == menuItem.name)) %}
                        {% set second_condition = (firstMenuItem is not null and not firstMenuItem and menuItem is not null and field_menu_item == menuItem.name) %}
                        {% set third_condition = (firstMenuItem is null and menuItem is null) %}

                        {% if first_condition or second_condition or third_condition %}

                            {% if not column_started %}
                                {{ _self.start_column(column.size, false, column.label) }}
                                {% set column_started = column.id %}
                            {% elseif column_started != column.id %}
                                {{ _self.end_column() }}
                                {{ _self.start_column(column.size, column.newLine, column.label) }}
                                {% set column_started = column.id %}
                            {% endif %}

                            {% set template = field.getShowTemplatePath() %}
                            {% include template with {
                                'data': field.value,
                                'field': field,
                                'resource': resource
                            } %}

                        {% endif %}
                    {% endif %}
                {% endfor %}

            {% endfor %}

            {% if column_started %}
                {{ _self.end_column() }}
            {% endif %}

        </div>
    </div>

{% endmacro %}
