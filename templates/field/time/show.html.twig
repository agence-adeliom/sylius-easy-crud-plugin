<table class="ui very basic celled table">
    <tbody>
        <tr>
            <td class="five wide"><strong class="gray text">{{ (field.label ?? field.property)|trans }}</strong></td>
            <td>
                {% if data is defined %}
                    <time datetime="{{ data|date('H:i:s') }}">{{ field.configurator.formatValue(field, data)|default(data|date('H:i:s')) }}</time>
                {% endif %}
            </td>
        </tr>
    </tbody>
</table>
