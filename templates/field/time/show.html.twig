<div class="row">
    <div class="col-12 col-md-4 fw-bold">{{ (field.label ?? field.property)|trans }}</div>
    <div class="col-12 col-md-8">
        {% if data is defined %}
            <time datetime="{{ data|date('H:i:s') }}">{{ field.configurator.formatValue(field, data)|default(data|date('H:i:s')) }}</time>
        {% endif %}
    </div>
</div>
