<div class="row">
    <div class="col-12 col-md-4 fw-bold">{{ (field.label ?? field.property)|trans }}</div>
    <div class="col-12 col-md-8">
        <div class="preview-icon border">
            <i class="{{ data ?: "" }}"></i>
        </div>
    </div>
    <style>
        .preview-icon {
            border: var(--border-width) var(--border-style) var(--border-color);
            width: 4rem;
            height: 4rem;
            display: flex;
            justify-content: center;
            align-items: center;
            border-radius: var(--border-radius);
            font-size: 2rem;
            position: relative;
        }
    </style>
</div>
