<div class="row">
    <div class="col-12 col-md-4 fw-bold">{{ (field.label ?? field.property)|trans }}</div>
    <div class="col-12 col-md-8">
        {% if data is defined %}
            {% if data is iterable %}
                {{ data|join(', ') }}
            {% else %}
                {{ data }}
            {% endif %}
        {% endif %}
    </div>
</div>
