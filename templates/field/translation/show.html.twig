{% import '@SyliusUi/Macro/flags.html.twig' as flags %}

<div class="ui styled fluid accordion">
    {% for locale in field.getCustomOption('definedLocalesCodes') %}
        {% set first_loop = loop %}
        {% for locale_value in field.getValue() %}
            {% if locale == locale_value.locale %}
                <div data-locale="{{ locale_value.locale }}">
                    <div class="title{% if first_loop.first %} active{% endif %}">
                        <i class="dropdown icon"></i>
                        {{ flags.fromLocaleCode(locale_value.locale) }} {{ locale_value.locale|sylius_locale_name }}
                    </div>
                    <div class="ui content{% if first_loop.first %} active{% endif %}">
                        {% set sub_fields = field.getCustomOption('fieldsDto') %}
                        {% for sub_field in sub_fields %}
                            {% set sub_field_dto = sub_field.getAsDto() %}
                            {% set template = sub_field_dto.getShowTemplatePath() %}
                            {% set value = get_resource_property_value(locale_value, sub_field_dto.property) %}
                            {% include template with {
                                'data': value,
                                'field': sub_field_dto,
                                'resource': resource
                            } %}
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
        {% endfor %}
    {% endfor %}
</div>
