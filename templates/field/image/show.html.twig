<div class="row">
    <div class="col-12 col-md-4 fw-bold">{{ (field.label ?? field.property)|trans }}</div>
    <div class="col-12 col-md-8">
        {% if data|default(null) is not null %}
            <img class="ui small bordered image" src="{{ data|imagine_filter('sylius_small') }}" alt="{{ data }}" />
        {% endif %}
    </div>
</div>
