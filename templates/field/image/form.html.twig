{% form_theme form _self %}

{% block upload_image_widget %}
    {% apply spaceless %}
    <div class="fields">
        <div class="field" data-file>
            <div class="mb-3 row">
                <div class="col-12 col-md-6 row mb-4">
                    <div class="col-auto">
                        <span class="avatar avatar-xl" style="background-image: url('{{ data|default(null) ? data|imagine_filter('sylius_small') : '' }}')"></span>
                    </div>
                    <div class="col">
                        {{ form_widget(form) }}
                        <div class="invalid-feedback">
                            {{- form_errors(form) -}}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {% endapply %}
{% endblock %}
