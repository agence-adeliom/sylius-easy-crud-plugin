{% form_theme form _self %}

{% block upload_image_widget %}
    {% apply spaceless %}
    <div class="fields">
        <div class="field" data-file>
            <div class="mb-3">
                {{ form_widget(form) }}
                {% if data|default(null) is not null %}
                    <div class="card" style="width: 200px">
                        <img class="card-img-top mb-3 image" src="{{ data|imagine_filter('sylius_small') }}" alt="{{ data }}" />
                    </div>
                {% endif %}
                <div class="invalid-feedback">
                    {{- form_errors(form) -}}
                </div>
            </div>
        </div>
    </div>
    {% endapply %}
{% endblock %}
