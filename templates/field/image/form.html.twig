{% form_theme form _self %}

{% block upload_image_widget %}
    {% apply spaceless %}
    <div class="fields">
        <div class="field" data-file>
            <label for="{{ form.vars.id }}" class="ui icon labeled button"><i class="cloud upload icon"></i> {{ 'sylius.ui.choose_file'|trans }}</label>
            {% if data|default(null) is not null %}
                <img class="ui small bordered image" src="{{ data|imagine_filter('sylius_small') }}" alt="{{ data }}" />
            {% endif %}
            <div class="ui hidden element">
                {{ form_widget(form) }}
            </div>
            <div class="ui element">
                {{- form_errors(form) -}}
            </div>
        </div>
    </div>
    {% endapply %}
{% endblock %}
