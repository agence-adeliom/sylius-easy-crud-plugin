{% if data is not null %}
    {% if data is same as ({}) or data is same as ([]) %}
        {{ data|serialize }}
    {% elseif data is same as (true) or data is same as (false) %}
        {% import '@SyliusUi/macro/labels.html.twig' as label %}
        {{ label.yesNo(data) }}
    {% else %}
        {{ data }}
    {% endif %}
{% endif %}
